# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.
# Genera la clave con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_ENV=development
SECRET_KEY=

# URI de Connect > Session pooler. Usa la cuenta de servidor y codifica la contraseña para URL.
DATABASE_URL=postgresql://ferrepro_backend.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Solo produccion: dominios autorizados separados por coma y saltos de proxy de confianza (0 a 5)
TRUSTED_HOSTS=
TRUSTED_PROXY_HOPS=0

# Segundos que vive una entrada de la cache en memoria (la invalidacion por escritura es inmediata)
CACHE_TTL=300

# Minutos que un pedido sin confirmar retiene el stock antes de cancelarse solo (0 desactiva)
ORDER_PENDING_EXPIRY_MINUTES=2880

FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Cuentas: enlaces de activacion (48 h) y recuperacion de contrasena (30 min)
# PUBLIC_BASE_URL=https://tu-dominio.com   (obligatorio en produccion para los enlaces)
# PASSWORD_RESET_MAX_AGE=1800
# ACCOUNT_ACTIVATION_MAX_AGE=172800

# Correo saliente (SMTP). Registro y reenvio requieren SMTP operativo.
# Gmail: smtp.gmail.com, 587, tu correo y una "contrasena de aplicacion" (no la de la cuenta).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASSWORD=
# SMTP_FROM=tu-correo@gmail.com
# SMTP_FROM_NAME=FerrePro
# SMTP_STARTTLS=true
# SMTP_SSL=false

# Asistente. Sin llave se usa el buscador local.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
