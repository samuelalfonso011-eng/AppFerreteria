# Copia este archivo como .env (junto a compose.yaml). Nunca lo subas al repositorio.
# Genera cada valor con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
POSTGRES_PASSWORD=
BACKEND_DB_PASSWORD=

# Opcional: apunta el contenedor a Supabase en lugar del PostgreSQL local
# DATABASE_URL=postgresql://ferrepro_backend.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Opcional: dominios permitidos (produccion) y procesos de gunicorn
# TRUSTED_HOSTS=localhost,127.0.0.1
# WEB_CONCURRENCY=2

# Correo de cuentas. Desarrollo con la bandeja local Mailpit (docker compose --profile mail up -d):
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# SMTP_FROM=no-reply@ferrepro.local
# PUBLIC_BASE_URL=http://localhost:8000
# Produccion: tu proveedor (Gmail con contrasena de aplicacion, Brevo, Outlook...) y la URL publica:
# SMTP_HOST=smtp.tu-proveedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@tu-dominio.com
# PUBLIC_BASE_URL=https://tu-dominio.com

# Tasa de impuesto de facturacion como fraccion entre 0 y 1.
INVOICE_TAX_RATE=0
