instance/

# Uploaded images (preserve structure, exclude user-uploaded images)
app/static/uploads/products/*
!app/static/uploads/products/.gitkeep

# IDEs and OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

