# ==============================================================================
# CONFIGURACIÓN DE ENTORNO — FERRETERÍA WEB (EJEMPLO)
# Copia este archivo como '.env' y completa con tus credenciales reales.
# NUNCA subas el archivo '.env' con secretos al repositorio de Git.
# ==============================================================================

# Entorno de ejecución: 'development', 'production', 'testing'
FLASK_ENV=development

# Clave secreta criptográfica para sesiones y tokens CSRF
# Genera una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion_por_un_hash_aleatorio

# Cadena de conexión PostgreSQL hacia Supabase
# Obtener en Supabase: Project Settings -> Database -> Connection string (URI)
# Ejemplo para conexión directa (puerto 5432):
# DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@[HOST_SUPABASE]:5432/postgres
# Ejemplo para Session Pooler / PgBouncer (puerto 6543):
# DATABASE_URL=postgresql://postgres.[PROYECTO]:[TU_PASSWORD]@[HOST_POOLER]:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:tu_password_aqui@db.tu_proyecto.supabase.co:5432/postgres

# Configuración de puerto y host para ejecución local
FLASK_RUN_PORT=5000
FLASK_RUN_HOST=127.0.0.1

# Parámetros de almacenamiento de archivos
MAX_CONTENT_LENGTH=5242880  # 5 MB límite para subida de fotos
UPLOAD_FOLDER=app/static/uploads/products
